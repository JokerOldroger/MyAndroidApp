EXPO_PUBLIC_LLM_PROXY_URL=https://your-server.example.com/robot-coach

# Less safe for production because Expo public env vars are visible in the app bundle.
# Prefer the proxy URL above for real projects.
EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4.1-mini
